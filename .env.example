# Port the relay listens on
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data

# Strong password for the web management console (required to enable login)
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Keep this key on the server only. Get an API key from your model provider.
UPSTREAM_API_KEY=replace-with-your-provider-api-key
UPSTREAM_BASE_URL=https://api.openai.com/v1

# Key configured in your app as its API key. Use a long random secret.
RELAY_API_KEY=replace-with-a-long-random-secret

# Optional hardening
MODEL_ALLOWLIST=gpt-4o-mini,gpt-4.1-mini
ALLOWED_ORIGINS=https://your-app.example.com
MAX_BODY_BYTES=10485760
UPSTREAM_TIMEOUT_MS=300000
